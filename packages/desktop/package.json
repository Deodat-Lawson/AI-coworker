{
  "name": "@ai-coworker/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Stead desktop app",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "electron-builder --publish never",
    "clean": "rm -rf dist release"
  },
  "dependencies": {
    "@ai-coworker/agent": "*",
    "@ai-coworker/shared": "*",
    "katex": "^0.16.47",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "app.stead.desktop",
    "productName": "Stead",
    "electronVersion": "33.4.11",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
